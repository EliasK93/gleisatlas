  "/heatmap": {
   "get": {
    "summary": "Heatmap",
    "operationId": "getHeatmap",
    "parameters": [
     {
      "name": "gattung",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "alle",
        "regional",
        "fern"
       ],
       "type": "string",
       "default": "alle",
       "title": "Gattung"
      }
     },
     {
      "name": "eva",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^[0-9]+$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Eva"
      }
     },
     {
      "name": "von",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Von"
      }
     },
     {
      "name": "bis",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Bis"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Heatmap"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
